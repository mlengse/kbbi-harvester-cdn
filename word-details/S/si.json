        "peribahasa_dan_makna": [
          {
            "peribahasa": "bagai si bisu berasian (bermimpi), terasa ada terkatakan tidak",
            "makna": "Menggambarkan keadaan seseorang yang memiliki pengetahuan atau perasaan, namun tidak mampu mengungkapkannya karena keterbatasan atau hambatan tertentu."
          },
          {
            "peribahasa": "bagai si kudung beroleh cincin",
            "makna": "Menggambarkan seseorang yang memperoleh sesuatu yang berharga, namun tidak dapat memanfaatkan atau menikmatinya karena keterbatasan diri."
          },
          {
            "peribahasa": "bagai si kudung pergi berbelut",
            "makna": "Menggambarkan seseorang yang mencoba melakukan sesuatu yang mustahil atau sangat sulit baginya karena keterbatasan fisik atau kemampuan."
          },
          {
            "peribahasa": "bagai si lumpuh hendak merantau",
            "makna": "Menggambarkan seseorang yang memiliki keinginan atau cita-cita besar, namun tidak mampu mewujudkannya karena keterbatasan fisik atau kondisi yang tidak memungkinkan."
          },
          {
            "peribahasa": "belum tentu si upik si buyungnya",
            "makna": "Menyiratkan bahwa masa depan seseorang belum dapat dipastikan; nasib atau takdir seseorang masih belum jelas."
          },
          {
            "peribahasa": "lubuk dalam, si kitang yang empunya",
            "makna": "Menggambarkan bahwa sumber daya atau kekuasaan dikuasai oleh pihak yang memiliki kekuatan atau pengaruh."
          },
          {
            "peribahasa": "si cebol hendak mencapai bulan (bintang)",
            "makna": "Menggambarkan seseorang yang memiliki cita-cita atau ambisi yang terlalu tinggi dan tidak realistis, melebihi kemampuan dirinya."
          }
        ]
      }
